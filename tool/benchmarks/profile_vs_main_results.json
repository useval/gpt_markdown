  "adapter_source": "import 'package:flutter/material.dart';\nimport 'package:gpt_markdown/gpt_markdown.dart' as current;\nimport 'package:gpt_markdown_main/gpt_markdown.dart' as main_branch;\nimport 'profile_rendering.dart' as bench;\nvoid main() => bench.runRenderingBenchmark(builders: {\n 'main': (source, key, streaming, animate) => main_branch.GptMarkdown(source,\n   key: key, isStreaming: streaming,\n   animation: animate ? main_branch.GptMarkdownAnimation.fade : main_branch.GptMarkdownAnimation.none,\n   style: const TextStyle(fontSize: 16, color: Colors.black)),\n 'current': (source, key, streaming, animate) => current.GptMarkdown(source,\n   key: key, isStreaming: streaming,\n   animation: animate ? current.GptMarkdownAnimation.fade : current.GptMarkdownAnimation.none,\n   style: const TextStyle(fontSize: 16, color: Colors.black)),\n 'sliver': (source, key, streaming, animate) => current.SliverGptMarkdown(source,\n   key: key, config: const current.GptMarkdownConfig(\n     style: TextStyle(fontSize: 16, color: Colors.black))),\n}, viewports: {'sliver': (child) => CustomScrollView(slivers: [child])});\n",
  "harness_change": "Skip name == 'sliver' when scenario.startsWith('stream_'); run with BENCH_ROUNDS=4",
